{
  "name": "excel-lock-manager",
  "version": "1.0.0",
  "private": true,
  "description": "社内向け Excel 一括ロック / 年度更新ツール (完全オフライン)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixtures": "esbuild test/make-fixtures.ts --bundle --platform=node --format=cjs --outfile=.test-build/fixtures.cjs --external:exceljs --log-level=warning && node .test-build/fixtures.cjs sample",
    "test": "esbuild test/engine.test.ts --bundle --platform=node --format=cjs --outfile=.test-build/engine.test.cjs --external:exceljs --log-level=warning && node .test-build/engine.test.cjs",
    "test:ui": "npm run build && esbuild test/make-fixtures.ts --bundle --platform=node --format=cjs --outfile=.test-build/fixtures.cjs --external:exceljs --log-level=warning && node .test-build/fixtures.cjs .test-build/sample --ascii && node test/ui.test.mjs",
    "test:all": "npm run test && npm run test:ui"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
